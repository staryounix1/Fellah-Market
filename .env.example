# Optional Supabase Backend Configuration
# Copy values into .env (or AI Studio Secrets) — never commit real secrets!
# When SUPABASE_URL and SUPABASE_ANON_KEY are set and DEMO_MODE=false, the app runs against live Supabase.
# SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
# SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# DEMO_MODE=true
